# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://lumina_user:lumina_password@localhost:5432/lumina_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=7d

# Usage limits (protect against runaway third-party API spend)
HOURLY_GENERATION_RATE_LIMIT=30
DAILY_GENERATION_LIMIT=50

# AI Service APIs
STABILITY_AI_API_KEY=your_stability_ai_key
STABILITY_AI_BASE_URL=https://api.stability.ai

RUNWAY_API_KEY=your_runway_key
RUNWAY_BASE_URL=https://api.runwayml.com

MESHY_API_KEY=your_meshy_key
MESHY_BASE_URL=https://api.meshy.ai

ELEVEN_LABS_API_KEY=your_eleven_labs_key
ELEVEN_LABS_BASE_URL=https://api.elevenlabs.io

# AWS S3 (for file storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=lumina-assets

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password