# Used by docker-compose.prod.yml (docker compose automatically reads a
# `.env` file in the same directory as the compose file for ${VAR}
# substitution). Copy this to `.env` and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up --build
#
# After the first `up`, apply database migrations (not run automatically
# by the backend's `npm start`):
#   docker compose -f docker-compose.prod.yml exec backend npx prisma migrate deploy

POSTGRES_USER=lumina_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lumina_db

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=7d

# Public URL of the frontend — used to build the link in password reset
# emails.
FRONTEND_URL=https://yourdomain.com

# Optional — without these, forgot-password requests log the reset link to
# the backend's console instead of emailing it (fine for local dev, not for
# production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The public URL of the backend, reachable from users' browsers (not the
# internal Docker network address) — baked into the frontend's client
# bundle at build time.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Each is optional — a provider without a key just fails that one
# generation type with a clear error; the rest of the app still works.
STABILITY_AI_API_KEY=
RUNWAY_API_KEY=
MESHY_API_KEY=
ELEVEN_LABS_API_KEY=

HOURLY_GENERATION_RATE_LIMIT=30
DAILY_GENERATION_LIMIT=50
